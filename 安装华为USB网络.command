#!/bin/bash
# ============================================================================
#  华为随身WiFi（E5577 等 HiLink 机型）—— USB 网卡模式 一键安装
#
#  作用：让 Mac 通过 USB 使用随身WiFi 上网，【不需要任何华为驱动】。
#        插上设备后会自动弹出终端窗口，按一下指纹（或输入密码）即可切换。
#
#  用法：在【终端】里运行   bash install-huawei-usb.sh
#
#  原理：设备默认处于「零CD/仅存储」USB 模式(12d1:1f01)，不会暴露网卡。
#        需要给它发一条 31 字节的 SCSI 命令，切到 HiLink 网络模式(12d1:14db)，
#        之后设备暴露标准 CDC-ECM，macOS 自带驱动直接识别，零驱动。
#
#  注意：切换需要 root（要摘下大容量存储驱动），且必须在【GUI 会话的终端】
#        里执行 —— 用 osascript 的 administrator privileges 会失败。
# ============================================================================
set -u

# 双击运行时，出错不能瞬间关窗，否则什么都看不到
die() {
    echo
    echo "❌ $*"
    echo
    printf "按回车键关闭窗口..."
    read -r _ || true
    exit 1
}

BIN="$HOME/bin/huawei-switch"
SRC="$HOME/bin/huawei-switch.c"
PROMPT="$HOME/bin/huawei-usb-prompt.command"
GUARD="$HOME/bin/huawei-autoswitch.sh"
PLIST="$HOME/Library/LaunchAgents/local.huawei-usb.plist"
LABEL="local.huawei-usb"

echo "════════════════════════════════════════════════"
echo "  华为随身WiFi → USB 网卡模式 安装程序"
echo "════════════════════════════════════════════════"
echo

ARCH=$(uname -m)
echo "[1/6] 检查环境"
echo "      架构: $ARCH"
echo "      用户: $(whoami)"
echo "      主目录: $HOME"
echo

mkdir -p "$HOME/bin" "$HOME/Library/LaunchAgents"

# ---------------------------------------------------------------------------
# 安装切换程序
# ---------------------------------------------------------------------------
compile_from_source() {
    echo "      尝试从源码编译..."
    if ! xcode-select -p >/dev/null 2>&1; then
        echo "      ❌ 未安装 Xcode Command Line Tools"
        echo "         请先运行: xcode-select --install"
        return 1
    fi
    local INC="" LIB=""
    for p in /opt/homebrew /usr/local; do
        if [ -f "$p/lib/libusb-1.0.a" ]; then
            INC="-I$p/include/libusb-1.0"
            LIB="$p/lib/libusb-1.0.a"
        fi
    done
    if [ -z "$LIB" ]; then
        echo "      ❌ 未找到 libusb。请先安装: brew install libusb"
        return 1
    fi
    clang -o "$BIN" "$SRC" $INC "$LIB" \
        -framework IOKit -framework CoreFoundation -framework Security || return 1
    echo "      ✅ 编译完成"
    return 0
}

echo "[2/6] 安装切换程序 -> $BIN"
if [ "$ARCH" = "arm64" ]; then
    base64 -d > "$BIN" <<'__B64_PAYLOAD__'

__B64_PAYLOAD__
    chmod +x "$BIN"
    echo "      ✅ 已安装 arm64 预编译版（静态链接，无外部依赖）"
else
    echo "      ⚠️  本机架构是 $ARCH，内置的是 Apple Silicon 版本"
    compile_from_source || die "安装失败（详见上面的编译错误）"
    chmod +x "$BIN"
fi

# 顺便放一份源码，便于日后自行编译
cat > "$SRC" <<'__SRC_PAYLOAD__'
/* 给华为 E5577 (12d1:1f01) 发送 USB 模式切换命令
 * 目的：从"零CD存储模式"切到 HiLink 网络模式 (12d1:14db)
 * 命令来源：usb-modeswitch-data/usb_modeswitch.d/12d1:1f01
 *
 * 注意：必须在 GUI 会话的终端里用 sudo 运行。
 * 经 launchd 特权助手(do shell script with administrator privileges)运行会因
 * IOCreatePlugInInterfaceForService 返回 e00002be(kIOReturnNoResources) 而 claim 失败。
 */
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <libusb.h>

static int hex2bin(const char *hex, unsigned char *out) {
    int n = 0;
    while (hex[0] && hex[1]) {
        unsigned int b;
        if (sscanf(hex, "%2x", &b) != 1) break;
        out[n++] = (unsigned char)b;
        hex += 2;
    }
    return n;
}

int main(void) {
    const char *hex = "55534243123456780000000000000a11062000000000000100000000000000";
    unsigned char msg[64];
    int msglen, r, transferred = 0, attempt;

    libusb_context *ctx = NULL;
    libusb_device_handle *h = NULL;

    msglen = hex2bin(hex, msg);
    printf("命令长度 = %d 字节\n", msglen);

    libusb_init(&ctx);

    h = libusb_open_device_with_vid_pid(ctx, 0x12d1, 0x1f01);
    if (!h) {
        printf("[X] 打开设备失败 —— 设备可能已经不在 12d1:1f01 模式了\n");
        libusb_exit(ctx);
        return 1;
    }
    printf("[OK] 设备已打开\n");

    r = libusb_kernel_driver_active(h, 0);
    printf("[?] kernel_driver_active(iface 0) = %d\n", r);
    if (r == 1) {
        r = libusb_detach_kernel_driver(h, 0);
        printf("[?] detach_kernel_driver(iface 0) = %d %s\n", r, r == 0 ? "(成功)" : "(失败)");
    }
    libusb_set_auto_detach_kernel_driver(h, 1);

    /* macOS 的 IOCreatePlugInInterfaceForService 不稳定，官方建议重试 */
    for (attempt = 1; attempt <= 8; attempt++) {
        r = libusb_claim_interface(h, 0);
        printf("[?] 第 %d 次 claim_interface(iface 0) = %d\n", attempt, r);
        if (r == 0) break;
        sleep(1);
    }
    if (r != 0) {
        printf("\n[X] 8 次重试后仍抢不到接口，退出\n");
        libusb_close(h);
        libusb_exit(ctx);
        return 1;
    }

    printf("\n[OK] 接口已抢到！\n");
    r = libusb_bulk_transfer(h, 0x01, msg, msglen, &transferred, 3000);
    printf("[%s] bulk_transfer(EP 0x01) = %d, 已发送 %d 字节\n",
           (r == 0 && transferred == msglen) ? "OK" : "X", r, transferred);

    if (r == 0 && transferred == msglen) {
        printf("\n>>> 切换命令已成功发出！设备应会重新枚举为 12d1:14db <<<\n");
    }

    libusb_release_interface(h, 0);
    libusb_close(h);
    libusb_exit(ctx);
    return 0;
}
__SRC_PAYLOAD__

# ---------------------------------------------------------------------------
# 切换窗口脚本 —— 这是主要用法（双击运行）
# ---------------------------------------------------------------------------
echo "[3/6] 安装切换窗口脚本 -> $PROMPT"
cat > "$PROMPT" <<'PROMPTEOF'
#!/bin/bash
# 华为随身WiFi -> USB 网卡模式
#
# 用法：插上设备后双击本文件（建议拖到 Dock 里，一次点击即可）。
#
# ⚠️ 为什么必须在【终端】里 sudo：
#    osascript 的 `do shell script ... with administrator privileges` 走的是
#    launchd 特权助手域，libusb 的 claim_interface 在那里必然报
#    IOCreatePlugInInterfaceForService: out of resources (e00002be)。
#    终端（GUI 会话）里 sudo 则正常。所以这里刻意只用 sudo。
#
# 授权：已启用 Touch ID for sudo 时按指纹，否则输入密码。

export PATH="/usr/bin:/bin:/usr/sbin:/sbin"

echo "════════════════════════════════════════"
echo "  华为随身WiFi -> USB 网卡模式"
echo "════════════════════════════════════════"
echo
echo "下面提示时请按指纹（或输入密码）"
echo

sudo "$HOME/bin/huawei-switch"
rc=$?

echo
if [ $rc -ne 0 ]; then
    echo "❌ 切换失败（退出码 $rc）"
    echo
    echo "按回车键关闭此窗口..."
    read
    exit 1
fi

echo "命令已发送，等待设备重新枚举..."
sleep 5

# 自动找 HUAWEI_MOBILE 对应的网卡名
# （不要写死 en11 —— 接口编号会随插入顺序变化）
IFACE=$(networksetup -listallhardwareports 2>/dev/null \
        | awk '/Hardware Port: HUAWEI_MOBILE/{getline; print $2}')

if [ -n "$IFACE" ] && ifconfig "$IFACE" 2>/dev/null | grep -q "inet "; then
    echo "✅ 完成，USB 网络已就绪："
    echo
    ifconfig "$IFACE" | grep -E "inet |status" | sed 's/^/    /'
    echo
    echo "提示：WiFi 与 USB 现在同在 192.168.8.x 网段，"
    echo "      建议用 USB 时把 WiFi 关掉，避免路由打架。"
    echo
    echo "本窗口 6 秒后自动关闭..."
    sleep 6
    exit 0
fi

echo "⚠️  切换命令已发送，但还没看到拿到 IP 的网卡。"
echo "    再等几秒；若始终没有，请到「系统设置 -> 网络」查看 HUAWEI_MOBILE。"
echo
echo "按回车键关闭此窗口..."
read
PROMPTEOF
chmod +x "$PROMPT"

# ---------------------------------------------------------------------------
# 可选：自动弹窗
# ---------------------------------------------------------------------------
AUTO=0
echo
echo "[4/6] 自动弹窗（可选）"
echo "      开启后：插上设备会自动弹出切换窗口，不用手动双击。"
echo "      不开启：插上后自己双击下面这个文件即可 ——"
echo "              $PROMPT"
printf "      要开启自动弹窗吗？[y/N] "
read -r ans
case "$ans" in
    [yY]*)
        echo "      -> 安装自动检测脚本 -> $GUARD"
        cat > "$GUARD" <<'GUARDEOF'
#!/bin/bash
# 由 LaunchAgent 触发：判断是否需要弹出"切换到 USB 网卡"窗口。
# 只有「设备处于 12d1:1f01 存储模式」且「本次插入还没弹过窗」才弹。
STATE="/tmp/.huawei-autoswitch.state"
USB=$(/usr/sbin/ioreg -p IOUSB -w0 -l 2>/dev/null)

if echo "$USB" | grep -q '"idProduct" = 5339'; then
    rm -f "$STATE"; exit 0
fi
if ! echo "$USB" | grep -q '"idProduct" = 7937'; then
    rm -f "$STATE"; exit 0
fi
if [ -f "$STATE" ]; then exit 0; fi

touch "$STATE"
exec /usr/bin/open -a Terminal "$HOME/bin/huawei-usb-prompt.command"
GUARDEOF
        chmod +x "$GUARD"

        echo "      -> 安装 LaunchAgent -> $PLIST"
        cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>$GUARD</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>WatchPaths</key>
	<array>
		<string>/Volumes</string>
	</array>
	<key>StartInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
PLISTEOF

        plutil -lint "$PLIST" >/dev/null 2>&1 || die "生成的 plist 格式错误"

        launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true
        launchctl bootout "gui/$UID/com.yao.huawei-usb" 2>/dev/null || true
        rm -f "$HOME/Library/LaunchAgents/com.yao.huawei-usb.plist"
        launchctl bootstrap "gui/$UID" "$PLIST" 2>/dev/null || true

        if launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1; then
            echo "      ✅ 已开启"
            AUTO=1
        else
            echo "      ⚠️  未能立即加载（下次登录会自动生效）"
            AUTO=1
        fi
        ;;
    *)
        echo "      -> 已跳过（手动双击模式）"
        # 清理可能存在的旧安装
        launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true
        launchctl bootout "gui/$UID/com.yao.huawei-usb" 2>/dev/null || true
        rm -f "$PLIST" "$HOME/Library/LaunchAgents/com.yao.huawei-usb.plist" "$GUARD"
        rm -f /tmp/.huawei-autoswitch.state
        ;;
esac

# ---------------------------------------------------------------------------
# Touch ID for sudo
# ---------------------------------------------------------------------------
echo
echo "[5/6] 启用 Touch ID for sudo（可跳过）"
if [ -f /etc/pam.d/sudo_local ] && grep -q pam_tid /etc/pam.d/sudo_local; then
    echo "      已启用，跳过"
else
    echo "      启用后，切换时按指纹即可授权，不用敲密码。"
    printf "      现在启用？会要一次密码 [Y/n] "
    read -r ans2
    case "$ans2" in
        [nN]*)
            echo "      已跳过。sudo 会提示输密码，功能不受影响。"
            ;;
        *)
            if sudo sh -c 'printf "# sudo_local: local config file which survives system update and is included for sudo\nauth       sufficient     pam_tid.so\n" > /etc/pam.d/sudo_local && chown root:wheel /etc/pam.d/sudo_local && chmod 444 /etc/pam.d/sudo_local'; then
                echo "      ✅ 已启用 Touch ID for sudo"
            else
                echo "      ⚠️  启用失败。sudo 会提示输密码，功能不受影响。"
            fi
            ;;
    esac
fi

# ---------------------------------------------------------------------------
# 完成
# ---------------------------------------------------------------------------
echo
echo "[6/6] 安装完成"
echo "════════════════════════════════════════════════"
echo
if [ "$AUTO" = "1" ]; then
    echo "已开启自动弹窗：插上设备后会自动弹出切换窗口，"
    echo "按一下指纹（或输密码）即可用 USB 上网。"
else
    echo "手动模式：插上设备后，双击下面这个文件即可 ——"
    echo
    echo "  $PROMPT"
    echo
    echo "建议把它拖到 Dock 里，以后一次点击就行。"
fi
echo
echo "现在就可以试试：插上设备，然后按上面的方式切换。"
echo
echo "────────────────────────────────────────────────"
echo "卸载方法："
echo "  launchctl bootout gui/\$(id -u)/$LABEL"
echo "  rm -f $HOME/Library/LaunchAgents/local.huawei-usb.plist"
echo "  rm -f $BIN $SRC $PROMPT $GUARD"
echo "  （Touch ID 若想关闭：sudo rm /etc/pam.d/sudo_local）"
echo "════════════════════════════════════════════════"
echo
printf "按回车键关闭窗口..."
read -r _ || true
exit 0
